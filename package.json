{
  "name": "reflexes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "run": "tsx scripts/run.ts",
    "jev": "tsx scripts/jev-smoke.ts",
    "core:build": "npm run build --prefix packages/core",
    "core:test": "npm run core:build && npm test --prefix packages/core",
    "core:example": "npm run core:build && npm run example --prefix packages/core",
    "research:replay": "npm run core:build && node research/replay.mts",
    "core:lint": "eslint packages/core/src packages/core/test packages/core/examples research",
    "research:test": "node --test research/replay.test.mjs"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.116",
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
